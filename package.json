{
  "name": "trend-keyword-infuser-mvp-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root project for Trend Keyword Infuser MVP, managing frontend and backend workspaces.",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "format": "npm run format --prefix frontend",
    "check-format": "npm run check-format --prefix frontend",
    "test": "npm test --prefix frontend",
    "build": "npm run build --prefix frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "npm-run-all": "^4.1.5"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
